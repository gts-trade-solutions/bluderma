# Copy to .env and fill in. Values below are placeholders, not defaults.

# ── Database ────────────────────────────────────────────────
# URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/bluderma"
# Only needed for `prisma migrate dev` on a shared/hosted MySQL.
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/bluderma_shadow"

# ── Auth ────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seeded on first `npm run db:seed`. Change the password after first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="BluDerma Admin"

# ── Storage: S3 + CloudFront ────────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
CDN_BASE_URL=""

# ── Email: AWS SES ──────────────────────────────────────────
# A dedicated SES key pair is preferred (lets you scope a send-only IAM user);
# leave these blank to fall back to the AWS_* keys above. SES_REGION falls back
# to AWS_REGION. EMAIL_FROM must be a verified SES identity (address or domain).
# The account must be out of the SES sandbox to email arbitrary recipients.
SES_REGION=""
SES_ACCESS_KEY_ID=""
SES_SECRET_ACCESS_KEY=""
EMAIL_FROM="BluDerma <noreply@example.com>"
# Inbox that receives a notification for every enquiry submitted on the site.
# Defaults to info@bluderma.kr if left blank. In the SES sandbox this address
# must be a verified identity (or request SES production access).
ENQUIRY_NOTIFY_EMAIL="info@bluderma.kr"

# Camera skin analyzer (external app). Shared secret must equal the analyzer's BLUDERMA_SHARED_SECRET.
SKIN_ANALYZER_URL="https://skinanalyzer.madenkorea.com"
SKIN_ANALYZER_SHARED_SECRET=""

# Optional: enables the AI-written skin-analysis summary. Leave blank to use
# the built-in deterministic summary instead.
OPENAI_API_KEY=""
# OPENAI_SUMMARY_MODEL="gpt-4o-mini"

# Razorpay — consultation payments. Without these the app still books
# appointments; they simply confirm immediately and are settled at the clinic.
# Dashboard → Settings → API Keys. Use rzp_test_* keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Subscribe /api/razorpay/webhook to
# payment.captured and payment.failed; this is NOT the API secret.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for the scheduled reminder job (/api/cron/reminders).
# Without it the endpoint refuses to run — a reminder job anyone can trigger
# is a way to mail-bomb your own patients. Vercel Cron sends it as a Bearer
# token; a manual ping can use ?key=<value>.
CRON_SECRET=

# ── Testing phase ─────────────────────────────────────────────────────────
# Shows a "Testing build" strip on the client and clinician home pages with a
# button that crosses between them. Handy while both sides are being checked;
# it is not product UI.
#
# Automatically ON in development. Set this to 1 to also show it on a staging
# deploy. Leave it UNSET in production — the strip then renders nothing, so
# turning it off is a matter of not setting a variable rather than remembering
# to delete a component.
# NEXT_PUBLIC_TESTING_LINKS=1
