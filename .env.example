# Copy to .env and fill in. Values below are placeholders, not defaults.

# ── Database ────────────────────────────────────────────────
# URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/bluderma"
# Only needed for `prisma migrate dev` on a shared/hosted MySQL.
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/bluderma_shadow"

# ── Auth ────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seeded on first `npm run db:seed`. Change the password after first login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="BluDerma Admin"

# ── Storage: S3 + CloudFront ────────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
CDN_BASE_URL=""

# ── Email: AWS SES ──────────────────────────────────────────
# A dedicated SES key pair is preferred (lets you scope a send-only IAM user);
# leave these blank to fall back to the AWS_* keys above. SES_REGION falls back
# to AWS_REGION. EMAIL_FROM must be a verified SES identity (address or domain).
# The account must be out of the SES sandbox to email arbitrary recipients.
SES_REGION=""
SES_ACCESS_KEY_ID=""
SES_SECRET_ACCESS_KEY=""
EMAIL_FROM="BluDerma <noreply@example.com>"
# Inbox that receives a notification for every enquiry submitted on the site.
# Defaults to info@bluderma.kr if left blank. In the SES sandbox this address
# must be a verified identity (or request SES production access).
ENQUIRY_NOTIFY_EMAIL="info@bluderma.kr"

# Camera skin analyzer (external app). Shared secret must equal the analyzer's BLUDERMA_SHARED_SECRET.
SKIN_ANALYZER_URL="https://skinanalyzer.madenkorea.com"
SKIN_ANALYZER_SHARED_SECRET=""

# Optional: enables the AI-written skin-analysis summary. Leave blank to use
# the built-in deterministic summary instead.
OPENAI_API_KEY=""
# OPENAI_SUMMARY_MODEL="gpt-4o-mini"
