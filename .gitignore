# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
# Scratch dist dirs — NEXT_DIST_DIR lets a verification build run without
# clobbering the .next the dev server is serving from.
/.next-*/
/out/

# Throwaway output from local render/responsive checks
/.chrome-mobile-check/
*-check-out.log
*-check-err.log

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal-only seed data — contains wholesale priceInr values, kept out of the public repo
prisma/catalog.ts
prisma/seed-catalog.ts

# Local render/verification scratch output
/.all-ba-dev-*.log
/.review-*.log
prisma/generated-*.json

# Media lives outside git — 1.1 GB of it, and GitHub is the wrong store for
# binaries this size. The database references these by root-relative path
# (/images/...), so any deploy must serve them from S3/CloudFront
# (S3_BUCKET + CDN_BASE_URL) or from a volume, not from the repo.
/public/images/
/public/videos/

# Review screenshots and render artifacts. Useful while checking a layout,
# not worth 11 MB in history.
/artifacts/
/docs/*.png

# Database dumps. They carry password hashes and every client record.
/backups/
*.sql.gz
