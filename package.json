{
  "name": "bluderma",
  "version": "0.1.0",
  "private": true,
  "description": "BluDerma - Dermatology & aesthetic reference platform for doctors and patients (frontend MVP)",
  "scripts": {
    "dev": "next dev",
    "build": "tsx prisma/gen-theme-overrides.ts --check && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:apply": "tsx prisma/apply-migrations.ts",
    "db:seed": "prisma db seed",
    "db:seed:catalog": "tsx prisma/seed-catalog.ts",
    "db:seed:demo": "tsx prisma/seed-demo-doctor.ts",
    "db:seed:demo:purge": "tsx prisma/seed-demo-doctor.ts --purge",
    "db:seed:features": "tsx prisma/seed-demo-features.ts",
    "db:seed:features:purge": "tsx prisma/seed-demo-features.ts --purge",
    "db:dump": "tsx prisma/dump-db.ts",
    "db:dump:schema": "tsx prisma/dump-db.ts --schema-only",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "verify:uploads": "tsx prisma/verify-uploads.ts",
    "verify:clinic-sync": "tsx prisma/verify-clinic-sync.ts",
    "verify:money": "tsx prisma/verify-money-inventory.ts",
    "verify:care": "tsx prisma/verify-pre-post-care.ts",
    "verify:phase5": "tsx prisma/verify-phase5.ts",
    "theme:gen": "tsx prisma/gen-theme-overrides.ts",
    "verify:themes": "tsx prisma/verify-themes.ts",
    "audit:demo": "tsx prisma/audit-demo-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/client-sesv2": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "razorpay": "^2.9.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.13",
    "tsx": "^4.23.1",
    "typescript": "5.4.5"
  }
}
