model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
