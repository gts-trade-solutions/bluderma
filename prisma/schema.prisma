// 9. Patient records — the My Profile sections
// ─────────────────────────────────────────────────────────────

/// A prescription issued to a patient after a consultation. `fileUrl` is the
/// uploaded PDF/image; the row exists even without one so the doctor's notes
/// are still on record.
model Prescription {
  id       String   @id @default(cuid())
  userId   String
  doctorId String?
  title    String
  notes    String?  @db.Text
  fileUrl  String?  @db.Text
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
  @@map("prescriptions")
}

/// An online purchase made by the patient. `amountInr` is their own
/// transaction, not catalogue pricing — the catalogue itself stays price-free.
model Purchase {
  id        String   @id @default(cuid())
  userId    String
  itemName  String
  quantity  Int      @default(1)
  status    String   @default("PLACED")
  amountInr Int?
  orderedAt DateTime @default(now())

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, orderedAt])
  @@map("purchases")
}

/// A discount made available to a patient (first-scan offer, loyalty, promo).
/// `usedAt` doubles as the redemption record.
model DiscountGrant {
  id           String    @id @default(cuid())
  userId       String
  code         String
  description  String
  percentOff   Int?
  amountOffInr Int?
  expiresAt    DateTime?
  usedAt       DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("discount_grants")
}

/// One completed "Help us to know you" questionnaire. Anonymous submissions
/// keep userId null; the answers blob is the whole quiz state as submitted.
model IntakeResponse {
  id      String  @id @default(cuid())
  userId  String?
  answers Json
  /// Human-readable one-liner for admin lists, derived at submit time.
  summary String? @db.Text

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("intake_responses")
}

// ─────────────────────────────────────────────────────────────
// 10. Payments (Razorpay)
// ─────────────────────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

/// One payment attempt against an appointment.
///
/// A row is written when the Razorpay order is created and updated once the
/// signature is verified — so an abandoned checkout leaves a CREATED row
/// rather than nothing, and the same appointment can be retried without
/// losing the audit trail. Amounts are whole INR; `amountMinor` keeps the
/// paise figure actually sent to Razorpay so reconciliation never depends on
/// re-deriving it.
enum PaymentPurpose {
  APPOINTMENT
  SKIN_SCAN
  SUBSCRIPTION
}

model Payment {
  id             String         @id @default(cuid())
  /// What was bought. A payment is for exactly one of the two, and the
  /// matching id below is set — the other stays null.
  purpose        PaymentPurpose @default(APPOINTMENT)
  appointmentId  String?
  /// The scan credit this payment bought, once the payment settles.
  entitlementId  String?
  /// The subscription term this payment bought, once the payment settles.
  subscriptionId String?
  userId         String?

  provider          String  @default("razorpay")
  providerOrderId   String  @unique
  providerPaymentId String? @unique
  /// Razorpay's returned signature, kept for dispute resolution.
  signature         String?

  amountInr     Int
  amountMinor   Int
  currency      String        @default("INR")
  status        PaymentStatus @default(CREATED)
  /// Razorpay's failure reason/description when a payment does not complete.
  failureReason String?       @db.Text

  paidAt DateTime?

  /// Refunds. Razorpay is the money's system of record; these columns are our
  /// copy of what it told us, so the ledger reconciles without a second call.
  refundId     String?
  refundedInr  Int?
  refundReason String?   @db.Text
  refundedAt   DateTime?
  /// The admin who issued it — a refund is a person's decision.
  refundedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([entitlementId])
  @@index([subscriptionId])
  @@index([purpose, status, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// 11. Client-facing catalogue (the explore hub)
// ─────────────────────────────────────────────────────────────
//
// Separate from Category/Treatment above, which is the clinician-facing
// catalogue behind /treatments and carries clinical notes and orderable
// products. This is the browse experience clients see: 18 categories, 108
// treatments, written for patients and edited by marketing.
//
// List-shaped fields (areas, includes, FAQs, options) are Json rather than
// side tables: they are edited as a block in one admin form, always read
// whole, and never queried across rows. A join table per bullet list would
// buy nothing and cost six more screens.

model HubCategory {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  /// Key into ICONS in components/hub/icons.tsx.
  icon  String
  /// Short line under the tile.
  blurb String @db.Text
  /// Longer intro shown on the category page.
  intro String @db.Text
  image String @db.Text
  /// Tailwind gradient classes for the icon chip.
  tint  String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatments HubTreatment[]
  protocol   TreatmentProtocol?

  @@index([isActive, sortOrder])
  @@map("hub_categories")
}

model HubTreatment {
  id          String  @id @default(cuid())
  categoryId  String
  slug        String
  name        String
  blurb       String  @db.Text
  image       String  @db.Text
  /// Treatment-specific illustrative comparison images. Both must be present
  /// before the patient page renders the before/after slider.
  beforeImage String? @db.Text
  afterImage  String? @db.Text
  /// Session count / downtime micro-fact. Never a price.
  meta        String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category         HubCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  beforeAfterCases HubBeforeAfterCase[]

  /// The URL is /patient/explore/<category>/<treatment>, so a slug only has
  /// to be unique inside its category.
  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
  @@map("hub_treatments")
}

model HubBeforeAfterCase {
  id          String @id @default(cuid())
  treatmentId String
  beforeImage String @db.Text
  afterImage  String @db.Text
  sortOrder   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatment HubTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([treatmentId, sortOrder])
  @@index([treatmentId, sortOrder])
  @@map("hub_before_after_cases")
}

/// The clinical protocol shown on a treatment page. Held per category because
/// every treatment in one shares the same protocol; a treatment that needs its
/// own wording gets it through HubTreatment overrides later.
model TreatmentProtocol {
  id         String @id @default(cuid())
  categoryId String @unique

  /// string[] — three statements about who this suits.
  recommendedFor Json
  summary        String @db.Text
  howItWorks     String @db.Text
  /// TreatmentOption[] — { name, detail, popular }.
  options        Json
  /// string[]
  areas          Json
  duration       String
  anaesthesia    String
  sessions       String
  downtime       String
  results        String @db.Text
  /// string[] each
  includes       Json
  excludes       Json
  precautions    Json
  sideEffects    Json
  notSuitable    Json
  aftercare      Json
  /// TreatmentFaq[] — { q, a }.
  faqs           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category HubCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("treatment_protocols")
}

// ─────────────────────────────────────────────────────────────
// 12. Reviews, marketing content and appointment history
// ─────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// A client's rating of the doctor they saw.
///
/// Anchored to an appointment rather than to a doctor, which is what makes it
/// trustworthy: you can only review a consultation you actually attended, and
/// only once. Reviews are moderated before they appear, because a public
/// rating on a clinician is not something to publish unread.
model Review {
  id            String       @id @default(cuid())
  appointmentId String       @unique
  userId        String
  doctorId      String
  /// 1–5 whole stars.
  rating        Int
  title         String?
  body          String?      @db.Text
  status        ReviewStatus @default(PENDING)
  /// Why it was rejected, or a note for whoever looks next.
  adminNote     String?      @db.Text
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

/// A promotional offer on the explore hub. Percentages only — the catalogue
/// is price-free, so a deal advertises a discount, never a rupee figure.
model HubDeal {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  treatment     String
  categorySlug  String
  categoryLabel String
  image         String    @db.Text
  /// Percentage off — the only number shown. Never a rupee amount.
  discount      Int
  /// What is included, e.g. "Free follow-up + take-home kit".
  perk          String
  /// Social proof count shown on the card.
  claimed       Int       @default(0)
  /// Human urgency line, e.g. "Ends in 6 days".
  endsIn        String
  /// "Hot" deals get the prominent rail; the rest sit in the general list.
  isHot         Boolean   @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isHot, sortOrder])
  @@map("hub_deals")
}

/// A slide in the trending carousel on the explore hub.
model HubPromo {
  id        String    @id @default(cuid())
  slug      String    @unique
  eyebrow   String
  title     String
  body      String    @db.Text
  image     String    @db.Text
  cta       String
  href      String
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("hub_promos")
}

/// A "what is bothering you?" tile, which routes into a category.
model HubConcern {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  hint      String
  image     String  @db.Text
  /// The hub category slug this opens.
  category  String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("hub_concerns")
}

// ===========================================================================
//  CLINICS
//
//  Until now a clinic was two free-text strings on the doctor row, which made
//  three things impossible: a doctor holding hours at more than one location,
//  a client searching for the nearest branch, and a calendar that can tell
//  those locations apart. This is that entity.
//
//  A clinic exists independently of any doctor. Several practitioners share
//  one; a practitioner works at several. DoctorClinic is the join, and it
//  carries the fee because branches of the same practice charge differently.
// ===========================================================================

model Clinic {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  addressLine1 String
  addressLine2 String?
  /// Neighbourhood, e.g. "Anna Nagar". What clients actually navigate by.
  area         String
  city         String
  state        String  @default("Tamil Nadu")
  pincode      String
  /// Set when the address has been geocoded, for "clinics near me".
  lat          Float?
  lng          Float?
  phone        String?
  email        String?
  /// Which swatch this location gets on the doctor calendar. An explicit
  /// column rather than a hash of the id, so it stays stable and a doctor
  /// with two similar-looking clinics can tell them apart deliberately.
  colorKey     String  @default("blue")
  about        String? @db.Text

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors      DoctorClinic[]
  photos       ClinicPhoto[]
  facilities   ClinicFacility[]
  availability DoctorAvailability[]
  appointments Appointment[]

  @@index([isActive, city])
  @@index([city, area])
  @@map("clinics")
}

enum ClinicPhotoKind {
  EXTERIOR
  INTERIOR
  ROOM
}

/// Photographs of the premises. Clients judge a clinic on these before they
/// judge it on anything else, which is why onboarding asks for them.
model ClinicPhoto {
  id        String          @id @default(cuid())
  clinicId  String
  url       String          @db.Text
  kind      ClinicPhotoKind @default(INTERIOR)
  alt       String?
  sortOrder Int             @default(0)

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, kind, sortOrder])
  @@map("clinic_photos")
}

/// Parking, lift access, in-house pharmacy, lab. Free text rather than an
/// enum because the list grows with the network and an admin should not need
/// a migration to add "valet".
model ClinicFacility {
  id        String @id @default(cuid())
  clinicId  String
  name      String
  sortOrder Int    @default(0)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name])
  @@map("clinic_facilities")
}

/// A practitioner practising at a location.
///
/// The fee lives here, not on Doctor, because the same doctor charges
/// differently at a flagship branch and a suburban one. Doctor.fee remains as
/// the headline figure and is kept in step with the primary clinic.
model DoctorClinic {
  doctorId  String
  clinicId  String
  /// Consultation fee in whole INR at this location.
  feeInr    Int     @default(0)
  /// The location that stands for this doctor in listings and on their card.
  /// Exactly one per doctor; enforced in the action, not the schema.
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([doctorId, clinicId])
  @@index([clinicId, isActive])
  @@index([doctorId, isPrimary])
  @@map("doctor_clinics")
}

// ===========================================================================
//  WHITE COLLAR  -  the client membership
//
//  Billed as a one-time order per term rather than through Razorpay's
//  Subscriptions API: it reuses settlePayment()'s existing purpose branch and
//  needs no dashboard Plan setup. The consequence, stated plainly, is that
//  nothing auto-debits — a term ends and the member is asked to renew.
//  razorpaySubscriptionId is reserved so true recurring billing can be added
//  later without moving any data.
// ===========================================================================

enum SubscriptionInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  /// Paid and inside its term.
  ACTIVE
  /// Term ran out without a renewal.
  EXPIRED
  /// Member stopped it. Benefits run to the end of the paid term.
  CANCELLED
}

model SubscriptionPlan {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  interval     SubscriptionInterval @default(MONTHLY)
  priceInr     Int
  /// Struck-through "was" figure, for the annual saving. Null shows no strike.
  compareAtInr Int?

  // ── What the member actually gets ────────────────────────────────────
  /// Taken off the consultation fee at every listed clinic.
  discountPercent      Int     @default(0)
  /// Skin scans granted at the start of each paid term.
  scanCredits          Int     @default(0)
  /// Unlocks held-back slots and protects the booking from being moved.
  priorityBooking      Boolean @default(false)
  /// Cancelling never costs a member the standard fee.
  waiveCancellationFee Boolean @default(false)
  /// Free-text bullets shown on the pricing card.
  perks                Json?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  planId String

  status SubscriptionStatus @default(ACTIVE)

  startedAt              DateTime  @default(now())
  /// The moment benefits stop. Renewing extends this rather than making a row.
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  /// Reserved for the Subscriptions API. Nothing auto-debits today.
  autoRenew              Boolean   @default(false)
  razorpaySubscriptionId String?   @unique

  /// Stops the renewal reminder going out twice for the same term.
  renewalNoticeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}
