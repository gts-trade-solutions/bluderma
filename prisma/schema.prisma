// BluDerma — data model
// Day 1 of the sprint: full schema for content, identity, and transactions.
//
// Design notes worth knowing before you edit:
//  - Content tables (Category/Treatment/Banner/Faq/...) are admin-editable CMS rows.
//    Everything the site renders comes from here, not from src/data/*.ts.
//  - Doctor is a *directory record* (admin-managed). It optionally links 1:1 to a
//    User so a practitioner can log in and see their own appointments.
//  - Appointment.slotLock is a real column, not a generated one: the app writes
//    "<doctorId>@<ISO datetime>" on booking and NULLs it on cancel. MySQL allows
//    many NULLs in a unique index, so this prevents double-booking while letting a
//    cancelled slot be rebooked. Keep that invariant in the booking action.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 1. Identity & auth  (NextAuth-compatible)
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  /// The identifier this person is quoted, on paper and on the phone.
  /// "BLU-P-4K7M2Q". Random rather than sequential: a counter would
  /// announce how many clients the business has and let anyone walk the
  /// list. Nullable only so existing rows could be backfilled; every new
  /// account gets one at creation.
  publicId      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?   @db.Text
  /// Null for OAuth-only accounts. Argon2/bcrypt hash — never a raw password.
  passwordHash  String?
  phone         String?
  role          Role      @default(PATIENT)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  doctor             Doctor?
  patientProfile     PatientProfile?
  analyses           SkinAnalysis[]
  skinScans          SkinScan[]
  skinEntitlements   SkinEntitlement[]
  skinAccessRequests SkinAccessRequest[]
  appointments       Appointment[]        @relation("PatientAppointments")
  assignedLeads      Enquiry[]            @relation("LeadOwner")
  enquiryNotes       EnquiryNote[]
  uploads            MediaAsset[]
  auditLogs          AuditLog[]
  prescriptions      Prescription[]
  purchases          Purchase[]
  discounts          DiscountGrant[]
  intakes            IntakeResponse[]
  reviews            Review[]
  subscriptions      Subscription[]
  addresses          PatientAddress[]
  instalmentPlans    InstalmentPlan[]
  aftercareSheets    AftercareSheet[]
  financingRequests  FinancingRequest[]
  treatmentPlans     TreatmentPlan[]
  galleryConsents    DoctorGalleryCase[]
  photos             PatientPhoto[]
  chartNotes         PatientNote[]
  giftCardsBought    GiftCard[]
  medicineOrders     MedicineOrder[]
  pushSubscriptions  PushSubscription[]

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────
// 2. Treatment catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  /// Display name, e.g. "Laser & Energy". Matches the old TreatmentCategory union.
  name      String  @unique
  blurb     String? @db.Text
  image     String? @db.Text
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  treatments Treatment[]

  @@index([sortOrder])
  @@map("categories")
}

model Treatment {
  id           String @id @default(cuid())
  /// Quotable catalogue reference, e.g. "BLU-T-4K7M2Q". See lib/publicId.ts.
  publicId     String? @unique
  slug         String @unique
  name         String
  categoryId   String
  tagline      String @db.Text
  image        String @db.Text
  summary      String @db.Text
  /// The patient concern / indication this treatment addresses.
  concern      String @db.Text
  /// How the treatment works — the clinical solution.
  howItWorks   String @db.Text
  /// Shown only to signed-in clinicians (replaces the old <DoctorOnly> gate).
  clinicalNote String @db.Text

  // Quick-facts spec strip
  factSessions String
  factDowntime String
  factResults  String
  factDuration String

  // The orderable product/solution (was Treatment.product, 1:1 embedded)
  productName       String
  productDescriptor String @db.Text

  seoTitle       String?
  seoDescription String? @db.Text
  sortOrder      Int     @default(0)
  isPublished    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category           @relation(fields: [categoryId], references: [id])
  bullets      TreatmentBullet[]
  testimonials Testimonial[]
  enquiries    Enquiry[]
  images       TreatmentImage[]
  products     TreatmentProduct[]

  @@index([categoryId])
  @@index([isPublished, sortOrder])
  @@map("treatments")
}

enum TreatmentImageKind {
  HERO
  BEFORE_AFTER
  RESULT
  HOW_IT_WORKS
  GALLERY
}

/// Typed image slots for a treatment page (before/after, result, how-it-works,
/// gallery). Separate from Treatment.image, which stays the single hero.
model TreatmentImage {
  id          String             @id @default(cuid())
  treatmentId String
  kind        TreatmentImageKind @default(GALLERY)
  url         String             @db.Text
  caption     String?
  sortOrder   Int                @default(0)

  createdAt DateTime @default(now())

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@index([treatmentId, kind, sortOrder])
  @@map("treatment_images")
}

// ─────────────────────────────────────────────────────────────
// Product catalog (orderable solutions, enquiry-to-order)
// ─────────────────────────────────────────────────────────────

/// A distributable product a clinic can enquire to order. Details are
/// web-researched. `priceInr` is stored for internal admin reference and is
/// NEVER rendered on any public page — the site is enquiry-only.
model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Manufacturer / house brand, e.g. "Hugel", "Medytox".
  brand       String?
  /// Catalog section, e.g. "Botulinum Toxin", "HA Filler", "Biostimulator".
  category    String
  origin      String? @default("Korea")
  tagline     String? @db.Text
  description String? @db.Text
  howItWorks  String? @db.Text
  /// Active ingredient / composition.
  composition String? @db.Text
  /// Storage, reconstitution, handling notes.
  usageNotes  String? @db.Text

  /// Internal only. Never shown publicly.
  priceInr  Int?
  priceNote String?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Enrichment bookkeeping so a staged web-research pass is resumable.
  enrichedAt DateTime?
  sourceUrl  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants   ProductVariant[]
  bullets    ProductBullet[]
  images     ProductImage[]
  treatments TreatmentProduct[]

  @@index([category, sortOrder])
  @@index([isPublished, sortOrder])
  @@map("products")
}

enum ProductBulletKind {
  FEATURE
  BENEFIT
  INDICATION
}

model ProductBullet {
  id        String            @id @default(cuid())
  productId String
  kind      ProductBulletKind
  text      String            @db.Text
  sortOrder Int               @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, kind, sortOrder])
  @@map("product_bullets")
}

/// Unit sizes / grades, e.g. "100 unit" / "200 unit", or "Sub-Q / Deep / Fine".
/// priceInr per variant is internal-only, like Product.priceInr.
model ProductVariant {
  id        String @id @default(cuid())
  productId String
  label     String
  priceInr  Int?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@map("product_variants")
}

/// Up to 5 per product (enforced in the admin, not the DB).
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Many-to-many: a product can suit several treatments; a treatment lists many
/// products. `isPrimary` marks the headline solution for a treatment.
model TreatmentProduct {
  treatmentId String
  productId   String
  sortOrder   Int     @default(0)
  isPrimary   Boolean @default(false)

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([treatmentId, productId])
  @@index([productId])
  @@map("treatment_products")
}

enum BulletKind {
  CONCERN_POINT
  PROCEDURE_STEP
  BENEFIT
  IDEAL_FOR
}

/// The four ordered bullet lists on a treatment page, in one table so the
/// admin can add/remove/reorder items without a schema change.
model TreatmentBullet {
  id          String     @id @default(cuid())
  treatmentId String
  kind        BulletKind
  text        String     @db.Text
  sortOrder   Int        @default(0)

  treatment Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@index([treatmentId, kind, sortOrder])
  @@map("treatment_bullets")
}

// ─────────────────────────────────────────────────────────────
// 3. Skin concerns  (unifies the two vocabularies that existed)
// ─────────────────────────────────────────────────────────────

/// Canonical concern list. `key` is the camelCase MetricKey used by the analyzer
/// (acne, darkCircles, ...); `legacyKey` is the snake_case name the marketing
/// grid used (dark_circle, ...) so old links/copy still resolve.
model SkinConcern {
  id          String  @id @default(cuid())
  key         String  @unique
  legacyKey   String? @unique
  label       String
  hint        String
  description String? @db.Text
  sortOrder   Int     @default(0)
  isFeatured  Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorFocus    DoctorConcern[]
  analysisScores SkinAnalysisScore[]

  @@index([sortOrder])
  @@map("skin_concerns")
}

// ─────────────────────────────────────────────────────────────
// 4. Practitioners, availability
// ─────────────────────────────────────────────────────────────

enum ConsultMode {
  CLINIC
  VIDEO
  /// The clinician travels to the patient. Carries a visit surcharge on top
  /// of the consultation fee (see SiteSetting "booking.home_visit_fee").
  HOME
}

/// Where a practitioner sits in the approval pipeline.
///
/// Kept on the Doctor row rather than in a separate application table so that
/// there is one record to edit before and after approval, and resubmission
/// after a rejection is a status change rather than a data copy. The cost is
/// that every public read MUST filter — see PUBLIC_DOCTOR_WHERE in
/// src/lib/queries/doctors.ts, which is the only sanctioned way to do it.
enum DoctorStatus {
  /// Signed up, still filling the onboarding wizard in.
  DRAFT
  /// Submitted, waiting on an admin.
  PENDING
  /// Live on the site.
  APPROVED
  /// Turned down, with a reason. May be edited and resubmitted.
  REJECTED
  /// Was approved, since withdrawn. Not deleted — appointments reference it.
  SUSPENDED
}

/// A day's worth of practice suggestions for one doctor.
///
/// Cached because it is the only paid call in the product: the metrics are
/// recomputed on every dashboard load, but the sentence written *about* them
/// is generated once a day. The unique key makes two concurrent first-renders
/// idempotent rather than racing to insert twice.
///
/// `source` is stored so the UI can label a deterministic strip honestly
/// instead of implying a model wrote it.
model DoctorDailyInsight {
  id          String   @id @default(cuid())
  doctorId    String
  /// Clinic wall-clock day, "2026-08-19". NOT the UTC day — 19:00Z is already
  /// tomorrow in clinic terms, and a UTC key would roll the cache at 05:30.
  dateKey     String
  /// Fingerprint of the figures it was written from. Observability, not
  /// invalidation — a doctor's numbers move all day and regenerating on every
  /// change would defeat the point of caching.
  metricsHash String
  /// [{ title, body }] — three or four items.
  items       Json
  /// "ai" | "template"
  source      String
  model       String?
  createdAt   DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dateKey])
  @@index([doctorId, createdAt])
  @@map("doctor_daily_insights")
}

model Doctor {
  id              String  @id @default(cuid())
  /// "BLU-DR-9T3N6XB". Longer and differently segmented from a patient
  /// id on purpose: both appear on the same aftercare sheet, so a glance
  /// has to tell them apart. A client who later becomes a doctor keeps
  /// their BLU-P and gains this; they are two roles, not two people.
  publicId        String? @unique
  /// Stable public handle, e.g. "aarti-menon". Was Doctor.id in the seed data.
  slug            String  @unique
  /// Set once the practitioner has a login. Null = directory record only.
  userId          String? @unique
  name            String
  title           String
  specialty       String
  rating          Decimal @default(0) @db.Decimal(2, 1)
  reviews         Int     @default(0)
  experienceYears Int     @default(0)
  clinic          String
  location        String
  image           String  @db.Text
  /// Public contact details (used for directory/clinic contacts).
  phone           String?
  email           String?
  website         String?
  /// Social profiles the practitioner chooses to publish. Stored as full URLs
  /// after normalisation (a handle typed as "@name" is expanded on save), so
  /// every consumer can link them without re-deriving the platform.
  instagram       String?
  facebook        String?
  linkedin        String?
  youtube         String?
  /// Consultation fee in whole INR.
  fee             Int     @default(0)
  about           String  @db.Text
  verified        Boolean @default(false)
  /// Fallback practitioner shown when no concern-based match applies.
  isGeneral       Boolean @default(false)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  // ── Approval pipeline ────────────────────────────────────────────────
  /// Existing rows default to APPROVED so nothing already live changes.
  status          DoctorStatus @default(APPROVED)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?      @db.Text

  // ── Credentials ──────────────────────────────────────────────────────
  // What makes `verified` above mean something. Captured at onboarding and
  // checked by the admin before approval.
  /// e.g. "Tamil Nadu Medical Council", "NMC".
  regCouncil    String?
  regNumber     String?
  regYear       Int?
  licenceDocUrl String? @db.Text

  // ── Multi-clinic practice ────────────────────────────────────────────
  /// Minutes needed to travel between two clinics. Slots at one location are
  /// blocked this far either side of a booking at another. 0 keeps today's
  /// behaviour for every existing doctor.
  travelBufferMin    Int     @default(0)
  /// When on, a booking waits for the doctor to accept it before it is
  /// confirmed. Off by default, so existing doctors are unaffected.
  requiresApproval   Boolean @default(false)
  /// Slots per day held back for White Collar members until 24h out.
  priorityHoldPerDay Int     @default(0)

  // ── Where else they practise online ──────────────────────────────────
  /// Whether they already consult through another marketplace or portal.
  ///
  /// NULL means unanswered, which is different from false. The onboarding
  /// question is not compulsory and the form does not label it optional
  /// either — it is simply skippable — so "no answer" has to be storable
  /// and must never be read as "no".
  ///
  /// Not a gate on anything. It exists because a practitioner already
  /// taking bookings elsewhere has a calendar we do not see, and knowing
  /// that changes what we ask of them at approval.
  listedElsewhere      Boolean?
  /// Which ones, in their words. Only meaningful when the above is true.
  listedElsewhereNames String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  focus         DoctorConcern[]
  otherFocus    DoctorConcernOther[]
  languages     DoctorLanguage[]
  services      DoctorService[]
  specialtyAreas DoctorSpecialtyArea[]
  modes         DoctorMode[]
  availability DoctorAvailability[]
  timeOff      DoctorTimeOff[]
  appointments Appointment[]
  clinics      DoctorClinic[]

  patientPhotos   PatientPhoto[]
  photoPins       PhotoAnnotation[]
  chartNotes      PatientNote[]
  reroutesOut     AppointmentReroute[] @relation("RerouteFrom")
  reroutesIn      AppointmentReroute[] @relation("RerouteTo")
  giftCardOffers  GiftCardOffer[]
  medicines       Medicine[]
  expenses        PracticeExpense[]
  income          PracticeIncome[]
  assets          PracticeAsset[]
  treatmentPlans  TreatmentPlan[]
  galleryCases    DoctorGalleryCase[]
  aftercareNotes  AftercareNote[]
  aftercareSheets AftercareSheet[]
  prescriptions   Prescription[]

  reviewList    Review[]
  dailyInsights DoctorDailyInsight[]

  @@index([isActive, sortOrder])
  @@index([location])
  @@index([status, isActive])
  @@map("doctors")
}

/// Concerns this doctor focuses on — drives analyzer → doctor matching.
model DoctorConcern {
  doctorId  String
  concernId String
  weight    Int    @default(1)

  doctor  Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  concern SkinConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([doctorId, concernId])
  @@index([concernId])
  @@map("doctor_concerns")
}

/// A concern the practitioner named themselves, because the catalogue has no
/// row for it.
///
/// Kept apart from DoctorConcern on purpose. Those point at real SkinConcern
/// rows and are what the analyzer matches a client against; a free-text entry
/// joining that index would put a doctor in front of people on the strength of
/// a phrase nobody curated, and two doctors spelling the same thing
/// differently would never be matched to the same client. So these are shown
/// on the profile and are searchable, and they do not drive matching. When one
/// of them turns up often enough, an admin promotes it to a real SkinConcern
/// and it starts to.
model DoctorConcernOther {
  id        String @id @default(cuid())
  doctorId  String
  name      String
  sortOrder Int    @default(0)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, name])
  @@map("doctor_concerns_other")
}

/// A sub-speciality: "hair restoration", "acne scarring", "paediatric
/// dermatology".
///
/// A third axis, and genuinely distinct from the two beside it. `specialty` is
/// the single qualification line on the card ("Dermatologist"). DoctorService
/// is the procedures they perform. This is what they are known FOR — the
/// answer to "who do you send a difficult case of X to", which is neither of
/// the other two and is the thing a referring doctor and a searching client
/// both actually look for.
model DoctorSpecialtyArea {
  id        String @id @default(cuid())
  doctorId  String
  name      String
  sortOrder Int    @default(0)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, name])
  @@map("doctor_specialty_areas")
}

model DoctorLanguage {
  id        String @id @default(cuid())
  doctorId  String
  name      String
  sortOrder Int    @default(0)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, name])
  @@map("doctor_languages")
}

model DoctorService {
  id        String @id @default(cuid())
  doctorId  String
  name      String
  sortOrder Int    @default(0)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, name])
  @@map("doctor_services")
}

model DoctorMode {
  doctorId String
  mode     ConsultMode

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([doctorId, mode])
  @@map("doctor_modes")
}

/// Weekly recurring working hours. Slots are generated from these at read time
/// (replaces the hashed PRNG in slotsForDoctor()).
/// One working window. Multiple rows per day are the norm, not the
/// exception — an Indian practice typically runs a morning and an evening
/// session, and a doctor may hold both at different clinics.
model DoctorAvailability {
  id          String  @id @default(cuid())
  doctorId    String
  /// Which location these hours are at. Nullable only so the column could be
  /// added to existing rows; the backfill sets every one of them.
  clinicId    String?
  /// 0 = Sunday … 6 = Saturday, matching JS getDay().
  dayOfWeek   Int
  /// "09:00" — local clinic time, 24h.
  startTime   String
  endTime     String
  slotMinutes Int     @default(30)
  isActive    Boolean @default(true)

  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId, dayOfWeek, startTime])
  @@index([doctorId, isActive])
  @@index([clinicId])
  @@map("doctor_availability")
}

/// Holidays / blackouts that punch holes in the recurring availability.
model DoctorTimeOff {
  id       String   @id @default(cuid())
  doctorId String
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
  @@map("doctor_time_off")
}

// ─────────────────────────────────────────────────────────────
// 5. Patients, skin analysis
// ─────────────────────────────────────────────────────────────

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String?
  phone     String?
  age       Int?
  gender    Gender?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

/// A place a client asks to be seen at, or have something sent to.
///
/// This replaces DEMO_ADDRESSES, two invented Chennai addresses shown to every
/// client as though they were their own saved places. They also carried a city
/// and a state, which the whole site has been stripped of: a Korean visitor
/// reading their own profile should not find an Indian address in it.
///
/// Deliberately loose about shape. `line1` and `line2` are free text because
/// an address is not a schema, and a form that insists on a structure the
/// visitor's country does not use is worse than one that takes what they type.
/// `pincode` is optional for the same reason.
model PatientAddress {
  id     String @id @default(cuid())
  userId String

  /// What the client calls it: "Home", "Mum's place", "Clinic near work".
  label   String
  line1   String
  line2   String?
  pincode String?
  /// Free text, and only what the client chose to write.
  city    String?
  /// Where the client is reachable at this address, if it differs.
  phone   String?

  /// Exactly one per client, enforced in the action rather than the schema:
  /// a partial unique index on (userId) where isDefault is not portable to
  /// MySQL, so setDefault clears the others in the same transaction.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("patient_addresses")
}

/// A treatment course a client is paying for in instalments.
///
/// This replaces DEMO_PAY_LATER, which was the most serious of the three mocks
/// on My Profile. A fake wallet balance overstates a credit the clinic owes;
/// a fake "approved limit of ₹60,000 through BluDerma Care Credit" is a
/// statement about a lending facility, made to somebody deciding whether they
/// can afford a course of treatment. There is no such facility and no such
/// provider.
///
/// So this table records only what somebody actually agreed. Nothing computes
/// an approval, nothing quotes a limit that has not been granted, and with no
/// rows the profile says the programme is not open rather than inventing two
/// courses the client is supposedly halfway through paying for.
///
/// Money is whole rupees, as everywhere else in this schema.
model InstalmentPlan {
  id     String @id @default(cuid())
  userId String

  /// What is being paid for, in the words the client would recognise.
  item     String
  /// Who is actually extending the credit. Required: an instalment plan with
  /// no named provider is the exact ambiguity this table exists to remove.
  provider String

  totalInr         Int
  instalmentInr    Int
  /// How many instalments the agreement runs to.
  instalmentsTotal Int
  /// How many have been collected. Never derived from a date: a missed
  /// payment must not silently count itself as made.
  instalmentsPaid  Int @default(0)

  nextDueAt DateTime?
  /// Set when the course is fully paid, so a finished plan stops asking for
  /// money without needing a date comparison to work it out.
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, settledAt])
  @@map("instalment_plans")
}

/// A doctor's standing additions for one treatment.
///
/// The aftercare sheet ends with a section the treating doctor fills in, and
/// the clinic asked for those additions to come back the next time the same
/// doctor issues a sheet for the same treatment. So they are stored per
/// (doctor, treatment) rather than per sheet: written once, offered as the
/// starting point every time after, and editable before each issue.
///
/// This is a DRAFT, not a record. It is what appears pre-filled in the form;
/// what the patient was actually given is snapshotted on AftercareSheet, so
/// editing this never rewrites a document somebody is already holding.
/// Which side of the treatment a sheet or a standing note belongs to.
///
/// -- Why one model carries both -------------------------------------------
/// A pre-treatment sheet and an aftercare sheet are the same document with a
/// different date on it: a procedure, a patient, a list of things to do and
/// not do, a set of warnings, the doctor's own additions, and an
/// acknowledgement. Splitting them into two models would have duplicated the
/// snapshot rule, the acknowledgement, the issuing logic and the patient's
/// reading screen, and the two copies would have drifted the first time
/// either changed.
///
/// POST is the default because every row that existed before this column did
/// was an aftercare sheet, and a default that rewrites history is a default
/// that lies.
enum SheetKind {
  /// Issued BEFORE the appointment. What to stop taking, what to avoid, what
  /// to bring, when to arrive. The half that was missing entirely.
  PRE
  POST
}

model AftercareNote {
  id            String    @id @default(cuid())
  doctorId      String
  /// A doctor keeps separate standing notes for before and after the same
  /// treatment: "stop retinol a week before" and "no retinol for a week
  /// after" are different instructions that happen to name the same product.
  kind          SheetKind @default(POST)
  /// Folded form of the treatment name, so "CO2 Laser" and "co2 laser " share
  /// one drawer. See treatmentKey() in lib/aftercare/standard.ts.
  treatmentKey  String
  /// The treatment as the doctor last typed it, for showing back to them.
  treatmentName String
  body          String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, treatmentKey, kind])
  @@map("aftercare_notes")
}

/// One aftercare sheet, as issued to one patient.
///
/// Every word of it is COPIED here at the moment of issue: the standard do's,
/// don'ts and warnings as well as the doctor's own additions. That looks like
/// duplication and is the point. This is a clinical instruction the patient
/// acts on for a fortnight, and a later revision of the standard content, or
/// of the doctor's standing notes, must never silently change what they were
/// told. A sheet is a record of what was said, on the day it was said.
model AftercareSheet {
  id String @id @default(cuid())

  /// PRE or POST. See SheetKind.
  kind          SheetKind @default(POST)
  doctorId      String
  /// Null when the sheet was issued to somebody with no account, which the
  /// booking flow allows. The name and id below are what the sheet carries.
  patientUserId String?
  appointmentId String?

  /// Snapshotted identity, so the sheet still reads correctly if the patient
  /// later changes their name or the appointment is deleted.
  patientName     String
  patientPublicId String?
  doctorName      String
  doctorPublicId  String?
  clinicName      String?
  clinicContact   String?

  procedure     String
  /// The date of the procedure itself. In the future on a PRE sheet and in
  /// the past on a POST one, which is the whole difference between them.
  procedureDate DateTime
  /// POST only: when to come back. Null on a PRE sheet.
  reviewOn      DateTime?
  /// PRE only: what time to be at the clinic, when it differs from the
  /// appointment — some procedures need numbing an hour ahead.
  arriveAt      String?

  /// The content as issued. Json arrays of strings.
  intro            String  @db.Text
  dos              Json
  donts            Json
  warnings         Json
  /// The treating doctor's own additions for this patient. Overrides the
  /// standard list, and the sheet says so.
  doctorNotes      String? @db.Text
  emergencyContact String?

  issuedAt       DateTime  @default(now())
  /// Set when the patient confirms they have read it. Never inferred from a
  /// page view: the sheet asks them to confirm the instructions were
  /// explained, and only they can say that.
  acknowledgedAt DateTime?

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient     User?        @relation(fields: [patientUserId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientUserId, issuedAt])
  @@index([doctorId, issuedAt])
  @@index([kind, issuedAt])
  @@map("aftercare_sheets")
}

/// A client asking whether a treatment can be paid for over time.
///
/// This replaced a mock that quoted an "approved limit of 60,000 through
/// BluDerma Care Credit" and listed EMI options, which read as though this
/// platform were itself a lender. It is not, and there is no finance partner
/// integrated.
///
/// So the honest MVP is a request, not a quote: the client says which
/// treatment and roughly what it costs, the clinic comes back to them. No
/// limit is computed, no rate is shown, and nothing here implies an approval.
model FinancingRequest {
  id     String @id @default(cuid())
  userId String

  /// What they want to spread. Free text: they are describing it, not picking
  /// from a catalogue we would then be quoting a price against.
  treatment    String
  /// What they believe it costs, if they know. Their figure, never ours.
  estimatedInr Int?
  note         String? @db.Text

  status    FinancingStatus @default(NEW)
  /// Written by staff when they close it off.
  staffNote String?         @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("financing_requests")
}

enum FinancingStatus {
  NEW
  CONTACTED
  CLOSED
}

/// What a doctor proposes for one patient, after reading their analysis.
///
/// The AI's part is deliberately small. It reads the scan's own issue scores,
/// which the server computed, and proposes treatment NAMES drawn from the real
/// catalogue. It does not decide, it does not rank by anything clinical, and
/// every line it produces arrives as SUGGESTED, never accepted. A suggestion
/// only becomes part of a plan when the treating doctor says so.
///
/// That division is the point. A model that invents a treatment name is a
/// nuisance; a model whose output reaches a patient as a recommendation
/// without a clinician between is something else entirely.
model TreatmentPlan {
  id String @id @default(cuid())

  doctorId      String
  patientUserId String
  /// The analysis this was built from, when there was one. A doctor can also
  /// start a plan from nothing.
  scanId        String?
  appointmentId String?

  /// Set when the doctor releases it to the patient. Until then it is a draft
  /// the patient cannot see: half-formed clinical advice is worse than none.
  sharedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor  Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient User                @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  scan    SkinScan?           @relation(fields: [scanId], references: [id], onDelete: SetNull)
  items   TreatmentPlanItem[]

  @@index([doctorId, createdAt])
  @@index([patientUserId, sharedAt])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id     String @id @default(cuid())
  planId String

  /// Always a name from the real catalogue when the source is AI: the model's
  /// output is intersected against the vocabulary before it is stored, so an
  /// invented treatment cannot survive to the database. A doctor may type
  /// anything, because a doctor is allowed to know something we do not.
  treatment String
  /// Why, in one line. Written by whoever added it.
  rationale String? @db.Text

  source PlanItemSource @default(AI)
  state  PlanItemState  @default(SUGGESTED)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("treatment_plan_items")
}

enum PlanItemSource {
  AI
  DOCTOR
}

enum PlanItemState {
  SUGGESTED
  ACCEPTED
  DECLINED
}

/// A before-and-after pair a doctor shows publicly.
///
/// ── Consent is a row, not a promise ──────────────────────────────────────
/// These are photographs of a patient's face, so the question is not whether
/// the doctor believes they have permission but whether the patient gave it,
/// when, and for what. It is therefore captured in the app: the doctor
/// prepares the case, the patient sees the actual images they are being asked
/// about, and consent is stamped with a time.
///
/// A case cannot be PUBLISHED without consentGivenAt. That is enforced in the
/// action rather than by a database constraint MySQL cannot express, and it is
/// the single rule this model exists to hold.
///
/// consentWithdrawnAt is not the same as deleting the row. Somebody who
/// changes their mind must be able to say so and have the images come down
/// immediately, while the clinic keeps the record that consent was once given
/// and later withdrawn.
model DoctorGalleryCase {
  id       String @id @default(cuid())
  doctorId String

  treatmentName String
  caption       String? @db.Text
  /// Sessions, timescale: what a viewer needs to read the pair honestly.
  detail        String? @db.Text

  beforeUrl String @db.Text
  beforeKey String @db.Text
  afterUrl  String @db.Text
  afterKey  String @db.Text

  /// The patient these are of. Required: a gallery case with no identified
  /// subject is a case nobody can consent to.
  patientUserId      String
  consentRequestedAt DateTime  @default(now())
  consentGivenAt     DateTime?
  consentWithdrawnAt DateTime?

  status    GalleryStatus @default(DRAFT)
  sortOrder Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient User   @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([doctorId, status, sortOrder])
  @@index([patientUserId, consentGivenAt])
  @@map("doctor_gallery_cases")
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// Somebody applying to sell medicines through BluDerma.
///
/// Deliberately an APPLICATION rather than an account. Dispensing medicine is
/// a licensed activity, so the drug licence number is required and the
/// document is asked for: a marketplace that lets anyone list medicines is not
/// a marketplace, it is a liability. Nothing about submitting this creates a
/// seller, a listing, or a login.
///
/// The review is a human one. There is no automatic approval path, and there
/// should not be until somebody has actually looked at a licence.
model MedicineVendor {
  id String @id @default(cuid())

  /// "BLU-V-..." — quoted in correspondence, like every other party here.
  publicId String? @unique

  businessName String
  contactName  String
  email        String
  phone        String

  addressLine1 String
  addressLine2 String?
  area         String?
  city         String
  state        String
  pincode      String

  /// The regulatory gate. Required, because the alternative is a shop
  /// selling prescription medicine on an unverified claim.
  drugLicenceNo  String
  /// Stored in a private prefix and read through a signed URL, like a
  /// practitioner's registration certificate.
  drugLicenceUrl String? @db.Text
  drugLicenceKey String? @db.Text
  gstin          String?

  /// What they say they stock, in their own words. Free text at this stage:
  /// the catalogue mapping is a later conversation, after approval.
  categories String? @db.Text
  about      String? @db.Text

  status     VendorStatus @default(SUBMITTED)
  /// What the reviewer said. Sent back to the applicant on rejection, so it
  /// has to read as a message rather than an internal note.
  reviewNote String?      @db.Text

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  @@index([status, submittedAt])
  @@map("medicine_vendors")
}

enum VendorStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

/// Money a practice spent.
///
/// ── Operating cost, not capital ──────────────────────────────────────────
/// A machine purchase is NOT recorded here. It goes to PracticeAsset, and the
/// two are kept apart on purpose: subtracting a ₹5,00,000 laser from one
/// month's takings would show a catastrophic month for a purchase that earns
/// out over years, and a practitioner reading that number would draw exactly
/// the wrong conclusion from it.
///
/// So net profit here means takings minus running costs, and the machine is
/// tracked separately as something being recovered. Both figures are labelled
/// as what they are.
model PracticeExpense {
  id       String  @id @default(cuid())
  doctorId String
  clinicId String?

  category  ExpenseCategory @default(OTHER)
  label     String
  amountInr Int
  spentOn   DateTime
  note      String?         @db.Text

  /// How many people this covers, on a SALARY row.
  ///
  /// Null everywhere else, and null on a salary row the practitioner did not
  /// break down. It exists because "₹1,42,000 on salaries" is a number nobody
  /// can act on and "₹1,42,000 across 6 people" is one they can: the second
  /// invites the comparison with what those six are billing.
  headcount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([doctorId, spentOn])
  @@map("practice_expenses")
}

/// What a running cost was for.
///
/// Grouped for reading in lib/doctor/financeCore.ts rather than here: RENT,
/// UTILITIES and LAUNDRY are one line on a practitioner's mental P&L
/// ("the building"), but they are three different bills and merging them in
/// the enum would make it impossible to answer "why did utilities jump".
///
/// OTHER is kept rather than renamed to MISCELLANEOUS. Existing rows carry it,
/// and the label a practitioner reads is decided by categoryLabel(), which
/// already says "Miscellaneous" — a migration that rewrites live data to
/// change a word on a screen is a migration that can go wrong for nothing.
enum ExpenseCategory {
  RENT
  SALARY
  CONSUMABLES
  MARKETING
  UTILITIES
  MAINTENANCE
  TAX
  /// Stock bought FOR the dispensary. The other half of medicine sales, and
  /// the reason a practice can appear to make money on medicines while losing
  /// it — the sales were counted and the purchase was not.
  MEDICINES
  /// Linen, gowns, towels. Small, relentless, and never once entered under
  /// any of the categories above.
  LAUNDRY
  OTHER
}

/// Where money came from, when it was not a consultation.
///
/// -- Why this exists -----------------------------------------------------
/// The dashboard's revenue figure was appointments and nothing else, which
/// meant a practice selling ten thousand rupees of retail skincare a month
/// saw none of it, and the "net profit" underneath was computed from takings
/// that were missing a stream. Three of the four streams were already in the
/// database and simply never read: bookings on Appointment, medicine sales on
/// MedicineOrder, procedure charges on AssetUsage. This is the fourth — the
/// things that fit none of them.
///
/// -- What must NOT go in here --------------------------------------------
/// Anything already counted somewhere else. A laser session charge belongs on
/// AssetUsage, a medicine sale on MedicineOrder, a consultation on the
/// appointment. Entering one of those here double-counts it, and a revenue
/// figure that is quietly too high is worse than one that is honestly too low.
/// The form says so at the point of entry.
enum IncomeSource {
  /// Retail skincare, sunscreen, supplements sold over the counter.
  PRODUCT
  /// A course of treatment paid for up front.
  PACKAGE
  /// A room, a chair or a machine let to another practitioner.
  RENTAL
  /// Talks, training, medico-legal work.
  PROFESSIONAL
  MISCELLANEOUS
}

model PracticeIncome {
  id       String  @id @default(cuid())
  doctorId String
  clinicId String?

  source     IncomeSource @default(MISCELLANEOUS)
  label      String
  amountInr  Int
  receivedOn DateTime
  note       String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([doctorId, receivedOn])
  @@map("practice_income")
}

/// A machine or piece of equipment the practice bought.
///
/// Tracked so a practitioner can answer the question they actually have about
/// it: how much of this has it earned back, and roughly how many more uses
/// until it has paid for itself. That is arithmetic over recorded uses, never
/// a projection dressed up as one.
model PracticeAsset {
  id       String  @id @default(cuid())
  /// Quotable equipment reference, e.g. "BLU-E-7Q2NX". See lib/publicId.ts.
  publicId String? @unique
  doctorId String
  clinicId String?

  name    String
  /// What it is for, in the practitioner's words: "fractional CO2 laser".
  purpose String?

  costInr     Int
  purchasedOn DateTime
  /// Running costs attributable to it, e.g. an annual service contract.
  /// Counted into what still has to be recovered.
  upkeepInr   Int      @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  uses   AssetUsage[]

  @@index([doctorId, isActive])
  @@map("practice_assets")
}

/// One use of a machine, and what was charged for it.
///
/// Entered by the practitioner rather than derived from an appointment,
/// because the two do not line up: one visit can use two machines, one machine
/// can serve several people in a session, and plenty of uses are not billed at
/// all. Guessing at that mapping would produce a recovery figure nobody could
/// check, which is worse than asking for ten seconds of typing.
model AssetUsage {
  id      String @id @default(cuid())
  assetId String

  usedOn     DateTime
  /// What the patient was charged for this use. Zero is legitimate: a touch-up
  /// included in a course still wears the machine.
  chargedInr Int      @default(0)
  treatment  String?
  note       String?  @db.Text

  createdAt DateTime @default(now())

  asset PracticeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, usedOn])
  @@map("asset_usages")
}

/// A photograph of a patient, taken by them or by their doctor.
///
/// ── Why the angle is a column ────────────────────────────────────────────
/// Dermatology comparisons only mean anything between the same view. A
/// "before" taken face-on and an "after" taken three-quarters shows a change
/// in the camera, not in the skin. Asking for the angle costs one tap and is
/// the difference between a record and a shoebox of pictures.
///
/// Every one of these lives in the private `patients/` prefix and is served
/// only through a signed URL. Nothing here is public, ever, whoever took it.
model PatientPhoto {
  id            String  @id @default(cuid())
  patientUserId String
  /// Set when a doctor took it. Null for photographs the patient uploaded
  /// themselves, which belong to them and are shown to whoever they book with.
  doctorId      String?
  appointmentId String?

  angle      PhotoAngle @default(FRONT)
  url        String     @db.Text
  storageKey String     @db.Text
  note       String?    @db.Text

  /// When the photograph was TAKEN, which is not always when it was uploaded:
  /// a patient often submits last week's flare.
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  patient     User              @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  doctor      Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  annotations PhotoMarkup[]
  pins        PhotoAnnotation[]

  @@index([patientUserId, capturedAt])
  @@index([doctorId, capturedAt])
  @@map("patient_photos")
}

enum PhotoAngle {
  FRONT
  LEFT
  RIGHT
  BACK
  TOP
  CLOSE_UP
  OTHER
}

/// A doctor's freehand marks over a photograph.
///
/// ── Kept beside the image, never burnt into it ───────────────────────────
/// The strokes are stored as coordinates, so the original photograph is never
/// altered. That matters clinically: the unmarked image is the record, and a
/// circle drawn round a lesion in March must not become part of what the
/// February photograph shows. It also means marks can be corrected, layered
/// per doctor, and switched off to look at the skin underneath.
///
/// Coordinates are stored NORMALISED (0-1 of the image's width and height)
/// rather than in pixels, so a mark drawn on a phone lands in the same place
/// on a consulting-room monitor.
model PhotoMarkup {
  id       String @id @default(cuid())
  photoId  String
  doctorId String

  /// [{ "points": [[x,y], …], "color": "#f43f5e", "width": 3 }]
  strokes Json
  note    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo PatientPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  /// One layer per doctor per photograph. A second practitioner marking the
  /// same image gets their own, rather than editing somebody else's reading.
  @@unique([photoId, doctorId])
  @@map("photo_markups")
}

/// A point on a photograph, with the treatment proposed for it.
///
/// -- Why this is not part of PhotoMarkup ----------------------------------
/// PhotoMarkup is a clinical reading: freehand strokes round a lesion, one
/// layer per doctor, kept beside the image so the original is never altered.
/// This is a different thing entirely — it carries MONEY, and it is shown to
/// the patient. Folding a price into the stroke JSON would put a figure a
/// patient acts on inside an unqueryable blob that exists to record what a
/// clinician saw.
///
/// -- The care taken with the price ----------------------------------------
/// `priceInr` is indicative and the screen says so in those words. This
/// platform has already deleted one feature for implying a financial
/// commitment it could not stand behind (see FinancingRequest), and a number
/// pinned to a photograph of somebody's own face is exactly the kind of thing
/// read as a promise. Null is a first-class value and means "on assessment" —
/// which is the honest answer for most of dermatology before anyone is in a
/// chair.
model PhotoAnnotation {
  id       String @id @default(cuid())
  photoId  String
  doctorId String

  /// Normalised 0-1 of the image's width and height, exactly as PhotoMarkup
  /// stores its strokes — so a pin dropped on a phone lands in the same place
  /// on a consulting-room monitor.
  x Float
  y Float

  /// 1, 2, 3 — printed in the pin and beside the row, so the image and the
  /// list can be read against each other.
  label Int

  treatment String
  note      String? @db.Text

  /// Whole INR. NULL means "on assessment" and is not the same as zero.
  priceInr Int?
  /// How many are expected. Null when it is not a course.
  sessions Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo  PatientPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  doctor Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([photoId, label])
  @@index([doctorId, createdAt])
  @@map("photo_annotations")
}

/// A doctor's own notes on one patient. The chart.
model PatientNote {
  id            String  @id @default(cuid())
  doctorId      String
  patientUserId String
  appointmentId String?

  body String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient User   @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([doctorId, patientUserId, createdAt])
  @@map("patient_notes")
}

/// A gift card a clinic offers for sale.
///
/// ── Admin sees it before a patient does ──────────────────────────────────
/// A clinic writes the offer; it reaches the catalogue only once BluDerma has
/// approved it. This is a promise about money made in our name, on our
/// storefront, and the review is what stands behind that.
///
/// `valueInr` and `priceInr` are separate so a clinic can discount: a ₹5,000
/// card sold for ₹4,500. Neither is derived from the other, because a promo
/// where price equals value is legitimate and so is one where it does not.
model GiftCardOffer {
  id       String  @id @default(cuid())
  doctorId String
  clinicId String?

  title       String
  description String? @db.Text
  /// What the holder can spend.
  valueInr    Int
  /// What the buyer pays. May be less than the value; never more.
  priceInr    Int
  terms       String? @db.Text
  /// How long the card lasts once bought.
  validMonths Int     @default(12)

  imageUrl String? @db.Text
  imageKey String? @db.Text

  status     OfferStatus @default(DRAFT)
  reviewNote String?     @db.Text

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  doctor Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic?    @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  cards  GiftCard[]

  @@index([status, createdAt])
  @@index([doctorId, status])
  @@map("gift_card_offers")
}

enum OfferStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// One purchased card.
///
/// `balanceInr` is the live figure and is decremented on redemption, so a card
/// can be spent across several visits. It is NOT derived by subtracting
/// redemptions on read: a balance that has to be recomputed to be trusted is
/// one that disagrees with itself the first time a redemption fails halfway.
model GiftCard {
  id      String @id @default(cuid())
  offerId String

  /// "BLU-G-…" — what the holder quotes at the clinic.
  code String @unique

  buyerUserId    String
  recipientName  String?
  recipientEmail String?
  message        String? @db.Text

  valueInr   Int
  balanceInr Int

  /// The Razorpay payment. Null until it settles: a card must not be spendable
  /// before the money has actually arrived.
  paymentId String?
  paidAt    DateTime?

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  offer       GiftCardOffer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  buyer       User                 @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  redemptions GiftCardRedemption[]

  @@index([buyerUserId, createdAt])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id         String @id @default(cuid())
  giftCardId String

  amountInr     Int
  doctorId      String?
  appointmentId String?
  note          String?  @db.Text
  redeemedAt    DateTime @default(now())

  card GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, redeemedAt])
  @@map("gift_card_redemptions")
}

/// A medicine a doctor dispenses from their own practice.
///
/// ── Not the injectables catalogue ────────────────────────────────────────
/// The 210 rows in `Product` are botulinum toxins, fillers and biostimulators:
/// prescription-only clinical consumables a practitioner administers, whose
/// prices that model marks internal-only. They cannot be sold to a consumer
/// and are deliberately not reachable from here.
///
/// This is the doctor's own dispensary: the topicals and orals they actually
/// hand a patient after a consultation.
model Medicine {
  id       String @id @default(cuid())
  doctorId String

  name     String
  brand    String?
  /// Cream, tablet, solution.
  form     String?
  strength String?
  about    String? @db.Text

  priceInr Int
  mrpInr   Int?
  /// Null means the practice does not track a count for this one.
  ///
  /// Maintained by StockMovement rather than written directly, so the number
  /// on the shelf and the history that explains it can never disagree. See
  /// applyStockMovement() in lib/actions/medicines.ts.
  stock    Int?
  /// Warn at or below this. Null means never warn.
  lowStockAt Int?

  /// Almost always true here, and stated rather than assumed: it changes what
  /// the patient is asked for at checkout.
  prescriptionOnly Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor    Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  items     MedicineOrderItem[]
  movements StockMovement[]
  prescribed PrescriptionItem[]

  @@index([doctorId, isActive])
  @@map("medicines")
}

/// Why the count on the shelf changed.
enum StockMoveReason {
  /// A delivery came in.
  RECEIVED
  /// Handed to a patient in clinic.
  DISPENSED
  /// An online order took it.
  ORDER
  /// That order was cancelled and it came back.
  ORDER_CANCELLED
  /// A physical count did not match. Always carries a note.
  CORRECTION
  EXPIRED
  DAMAGED
}

/// One change to the count of one medicine.
///
/// -- Why a ledger rather than a column ------------------------------------
/// Medicine.stock was a bare integer that the order flow READ and never wrote:
/// placeMedicineOrder checked "is there enough?" and then created the order
/// without taking anything off the shelf. A practice with ten units could
/// accept fifty orders and still show ten. The check existed, so the bug read
/// as working software.
///
/// Fixing it as a decrement alone would have made the number right and left it
/// unexplainable — a doctor who finds 8 where they expect 12 needs to know
/// which four went and when. So every change is a row, `balance` is the level
/// AFTER it, and Medicine.stock is the last balance. A count and its own
/// audit trail, written in one transaction, so they cannot drift.
model StockMovement {
  id         String @id @default(cuid())
  medicineId String

  /// Signed. +12 received, -2 dispensed.
  delta   Int
  /// The level after this movement, so the history reads without re-summing.
  balance Int

  reason StockMoveReason
  note   String?         @db.Text

  /// The order that caused it, when one did.
  orderId String?

  /// Who did it. Null for a movement the order flow made on its own.
  actorUserId String?

  createdAt DateTime @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

/// A patient ordering medicines their doctor listed.
model MedicineOrder {
  id       String  @id @default(cuid())
  publicId String? @unique
  userId   String
  doctorId String?

  status MedicineOrderStatus @default(PLACED)

  /// The delivery address, copied at the time. A patient editing their address
  /// book later must not silently change where a past order went.
  deliverTo String  @db.Text
  phone     String?

  subtotalInr Int
  deliveryInr Int @default(0)
  totalInr    Int

  /// The prescription this order is filled against, when one was supplied.
  prescriptionUrl String? @db.Text
  prescriptionKey String? @db.Text

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MedicineOrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  /// The dispensary screen and the revenue figure both read by doctor and
  /// date, and neither had an index to read by.
  @@index([doctorId, createdAt])
  @@map("medicine_orders")
}

enum MedicineOrderStatus {
  PLACED
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model MedicineOrderItem {
  id         String  @id @default(cuid())
  orderId    String
  /// Null once a doctor deletes a medicine. The name and price below are
  /// copied at order time so the history survives the catalogue changing.
  medicineId String?

  name     String
  priceInr Int
  qty      Int    @default(1)

  order    MedicineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine?     @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("medicine_order_items")
}

model SkinAnalysis {
  id           String   @id @default(cuid())
  /// Null for anonymous runs before sign-in; claimed on login.
  userId       String?
  overall      Int
  skinType     String
  estimatedAge Int
  /// S3/CloudFront URL. Null while analysis stays client-side (current default).
  imageUrl     String?  @db.Text
  /// Deterministic seed used by the simulator; keeps results reproducible.
  seed         String?
  createdAt    DateTime @default(now())

  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores       SkinAnalysisScore[]
  appointments Appointment[]

  @@index([userId, createdAt])
  @@map("skin_analyses")
}

/// One row per metric per analysis — all 12 are stored, not just the top 3,
/// so the "re-analyse and compare" progress view is possible.
model SkinAnalysisScore {
  id         String @id @default(cuid())
  analysisId String
  concernId  String
  score      Int
  /// 1..3 for the worst concerns surfaced in the UI, else null.
  topRank    Int?

  analysis SkinAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  concern  SkinConcern  @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@unique([analysisId, concernId])
  @@index([concernId])
  @@map("skin_analysis_scores")
}

// ─────────────────────────────────────────────────────────────
// 5b. Camera skin analyzer (Face++) — standalone-analyzer integration.
// BluDerma is the authority for identity + entitlement; the external analyzer
// (skinanalyzer.madenkorea.com/bd) does the capture + Face++ and posts back a
// signed result. See lib/integrations/skinAnalyzer.ts.
// ─────────────────────────────────────────────────────────────

/// Canonical stored scan; `analyzerAnalysisId` unique = callback idempotency.
model SkinScan {
  id                 String    @id @default(cuid())
  userId             String
  /// The analyzer's own analysis id — unique so a retried callback is idempotent.
  analyzerAnalysisId String    @unique
  /// The entitlement row that authorised this scan.
  grantId            String
  status             String    @default("done")
  kind               String    @default("face")
  /// Derived summary (overall, skin_type, skin_age, top_concerns, base_image).
  summary            Json?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues       SkinScanIssue[]
  appointments Appointment[]

  treatmentPlans TreatmentPlan[]

  @@index([userId, createdAt])
  @@map("skin_scans")
}

/// Per-concern rows for a scan (type, score, confidence, severity band).
model SkinScanIssue {
  id           String  @id @default(cuid())
  scanId       String
  issueType    String
  score        Float?
  confidence   Float?
  severityBand String?
  details      Json?

  scan SkinScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("skin_scan_issues")
}

/// Quota lifecycle. The row id IS the token `grant_id`.
/// state: available → reserved → consumed | released.
model SkinEntitlement {
  id         String    @id @default(cuid())
  userId     String
  state      String    @default("available")
  /// "free" (the seeded first scan) or "granted" (admin-approved extra).
  source     String    @default("free")
  /// Reservation TTL; a reserved grant past this is lazily released on read.
  expiresAt  DateTime?
  reservedAt DateTime?
  consumedAt DateTime?
  releasedAt DateTime?
  /// The SkinScan produced when this grant was consumed.
  analysisId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@map("skin_entitlements")
}

/// "Request more scans" queue, approved by an admin.
model SkinAccessRequest {
  id           String    @id @default(cuid())
  userId       String
  status       String    @default("pending")
  note         String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("skin_access_requests")
}

// ─────────────────────────────────────────────────────────────
// 6. Transactions: appointments & leads
// ─────────────────────────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Whether a booking still needs the doctor to accept it.
///
/// Deliberately separate from AppointmentStatus, which already uses PENDING to
/// mean "payment pending" and is written from seven different places.
enum ApprovalState {
  /// The doctor takes bookings without reviewing them. Today's behaviour.
  AUTO
  /// Slot is held, waiting on the doctor.
  AWAITING_DOCTOR
  ACCEPTED
  DECLINED
}

/// Who performed an action. A cancellation by the clinic and a cancellation by
/// the client are the same status but very different events — the fee, the
/// email and the refund obligation all differ.
enum ActorKind {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
}

/// What the visit is actually for.
///
/// A booking used to reach the doctor as a time, a name and an optional free
/// text note that was almost always empty — so the first thing they learned
/// about a patient was whatever the patient chose to volunteer, if anything.
/// This is the structured half: enough to triage, prepare, and allocate the
/// right slot length before the patient walks in.
enum VisitReason {
  ACNE
  PIGMENTATION
  HAIR_LOSS
  ANTI_AGEING
  SCARS
  ROSACEA_REDNESS
  ECZEMA_PSORIASIS
  FUNGAL_INFECTION
  MOLE_CHECK
  COSMETIC_PROCEDURE
  FOLLOW_UP
  OTHER
}

/// How long the patient has had the concern. Dermatology triage leans on this
/// heavily — a rash of three days and a rash of three years are different
/// consultations.
enum SymptomDuration {
  UNDER_WEEK
  WEEKS_1_4
  MONTHS_1_6
  MONTHS_6_12
  OVER_YEAR
}

/// A photograph the patient attached when booking.
///
/// Dermatology is a visual speciality and a described rash is a poor substitute
/// for a seen one — but these are clinical images of a named person, so they
/// live in a PRIVATE bucket prefix and are reached only through a signed URL.
/// See PRIVATE_PREFIXES in prisma/setup-s3.ts and /api/uploads/view.
model AppointmentPhoto {
  id            String   @id @default(cuid())
  appointmentId String
  /// Full stored URL. Not publicly readable — signing is what serves it.
  url           String   @db.Text
  /// The object key, so access control can reason about the prefix.
  storageKey    String   @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, sortOrder])
  @@map("appointment_photos")
}

model Appointment {
  id            String            @id @default(cuid())
  /// Null for guest bookings taken over the phone by an admin.
  patientUserId String?
  doctorId      String
  /// Which of the doctor's locations this is at. Null on rows that predate
  /// multi-clinic support; the backfill sets them to the primary clinic.
  clinicId      String?
  scheduledAt   DateTime
  durationMin   Int               @default(30)
  mode          ConsultMode
  status        AppointmentStatus @default(CONFIRMED)
  /// Fee snapshot — Doctor.fee changes over time, this must not.
  feeAtBooking  Int
  /// Home-visit surcharge at booking time. 0 for clinic and video.
  visitFee      Int               @default(0)

  // Contact details as given at booking time (may differ from the profile).
  patientName  String
  patientPhone String?
  patientEmail String?
  notes        String? @db.Text

  // ── Why they are coming ──────────────────────────────────────────────
  // Captured at booking and shown to the doctor before the consultation.
  // Nullable because rows predating this, and admin-entered phone bookings,
  // have none — the booking form itself requires them.
  /// The presenting concern, from a fixed list so it can be triaged.
  reason          VisitReason?
  /// The patient's own description. Required by the form; the fixed list
  /// alone cannot carry "it flares when I use retinol".
  reasonDetail    String?          @db.Text
  symptomDuration SymptomDuration?
  /// Self-rated 1 (mild) to 5 (severe). Not a clinical score — a triage hint.
  severity        Int?
  /// What they have already tried, so the doctor does not re-prescribe it.
  priorTreatment  String?          @db.Text
  /// Current medication and known allergies. Blank is meaningful here, so the
  /// form asks explicitly rather than leaving the field empty by default.
  medications     String?          @db.Text
  allergies       String?          @db.Text
  isFirstVisit    Boolean          @default(true)
  /// Snapshotted from the profile at booking, because dermatology reads
  /// differently by age and sex and a profile can change afterwards.
  patientAge      Int?
  patientGender   Gender?
  /// Consent to clinical photography, asked once and recorded.
  photoConsent    Boolean          @default(false)
  /// The skin report the patient chose to attach, if any. There are two
  /// analysis systems — the older simulator (SkinAnalysis) and the camera
  /// analyzer (SkinScan) — and the patient's latest may be either, so both
  /// are referenced rather than collapsing them into one untyped id.
  skinAnalysisId  String?
  skinScanId      String?

  // ── Doctor confirmation ──────────────────────────────────────────────
  approvalState ApprovalState @default(AUTO)
  approvedAt    DateTime?
  declineReason String?       @db.Text

  // ── Video / teleconsult ──────────────────────────────────────────────
  /// The meeting link the doctor shares with the client (requirement D-10).
  meetingUrl String? @db.Text

  // ── White Collar ─────────────────────────────────────────────────────
  /// The membership that priced this booking, if any.
  subscriptionId String?
  /// Rupees taken off feeAtBooking by that membership. 0 for everyone else.
  discountInr    Int     @default(0)
  /// Members' bookings are protected from being moved without a reason.
  isPriority     Boolean @default(false)

  cancelReason       String?    @db.Text
  cancelledAt        DateTime?
  /// Who moved it and who called it off — see ActorKind.
  cancelledBy        ActorKind?
  rescheduledBy      ActorKind?
  confirmationSentAt DateTime?
  /// Charged when a client cancels inside the fee window. 0 when free.
  cancellationFeeInr Int        @default(0)
  /// How many times this booking has been moved. Capped by settings, so a
  /// slot cannot be held indefinitely by repeated rescheduling.
  rescheduleCount    Int        @default(0)
  /// The appointment this one replaced, when it came from a reschedule.
  rescheduledFromId  String?
  /// Set when a reminder has gone out, so the job never sends twice.
  reminderSentAt     DateTime?

  /// "<doctorId>@<ISO datetime>" while the slot is held; NULL once cancelled.
  /// The unique index on this is what actually prevents double-booking.
  slotLock String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review       Review?
  patient      User?              @relation("PatientAppointments", fields: [patientUserId], references: [id], onDelete: SetNull)
  doctor       Doctor             @relation(fields: [doctorId], references: [id])
  clinic       Clinic?            @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  payments     Payment[]
  /// SetNull rather than Cascade: losing a scan must never delete the
  /// appointment that referenced it.
  skinAnalysis SkinAnalysis?      @relation(fields: [skinAnalysisId], references: [id], onDelete: SetNull)
  skinScan     SkinScan?          @relation(fields: [skinScanId], references: [id], onDelete: SetNull)
  photos       AppointmentPhoto[]

  aftercareSheets AftercareSheet[]
  reroutes        AppointmentReroute[]

  @@index([doctorId, scheduledAt])
  @@index([patientUserId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([clinicId, scheduledAt])
  @@index([doctorId, approvalState])
  @@map("appointments")
}

/// Where a proposed hand-over has got to.
enum RerouteState {
  /// The doctor has asked; the patient has not answered.
  PROPOSED
  ACCEPTED
  DECLINED
  /// The proposing doctor withdrew it, or the appointment was cancelled.
  WITHDRAWN
}

/// One practitioner asking another to take a booking.
///
/// -- Why the patient has to agree -----------------------------------------
/// A client books a named doctor. Silently swapping that name because the
/// doctor is away is not a scheduling change, it is a different consultation
/// with a different person — and in aesthetics, where the choice of
/// practitioner IS the product, it is the thing most likely to make somebody
/// never come back.
///
/// So this is a PROPOSAL. The appointment does not move until the patient
/// says yes; if they decline, or say nothing, it stays where it is and the
/// original doctor deals with it. That is slower than reassigning and it is
/// the only version that can be defended to the person in the chair.
///
/// -- Why it is a row and not two columns on Appointment -------------------
/// A hand-over can be proposed, declined, and proposed again to somebody
/// else. Columns would keep only the last attempt; this keeps the trail,
/// which is what an admin needs when a patient rings to ask why they were
/// moved twice.
model AppointmentReroute {
  id            String @id @default(cuid())
  appointmentId String

  fromDoctorId String
  toDoctorId   String

  /// Shown to the patient verbatim. They are being asked to accept a
  /// different clinician; "the doctor is unavailable" with no more than that
  /// is not enough to decide on.
  reason String @db.Text

  state RerouteState @default(PROPOSED)

  proposedAt  DateTime  @default(now())
  respondedAt DateTime?
  /// Free text from the patient when they decline. Optional.
  patientNote String?   @db.Text

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromDoctor  Doctor      @relation("RerouteFrom", fields: [fromDoctorId], references: [id], onDelete: Cascade)
  toDoctor    Doctor      @relation("RerouteTo", fields: [toDoctorId], references: [id], onDelete: Cascade)

  @@index([appointmentId, proposedAt])
  @@index([toDoctorId, state])
  @@map("appointment_reroutes")
}

enum EnquiryAudience {
  DOCTOR
  PATIENT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

model Enquiry {
  id           String          @id @default(cuid())
  audience     EnquiryAudience
  name         String
  email        String
  phone        String?
  /// "Organisation" for clinicians, "City" for patients — same input, two labels.
  organisation String?
  /// Units requested. Clinician enquiries only.
  quantity     Int?
  message      String?         @db.Text

  treatmentId String?
  /// Product name snapshot, in case the treatment is later renamed or removed.
  productName String?

  status       EnquiryStatus @default(NEW)
  assignedToId String?
  source       String?       @default("web")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  treatment  Treatment?    @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("LeadOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes      EnquiryNote[]

  @@index([status, createdAt])
  @@index([audience])
  @@index([treatmentId])
  @@map("enquiries")
}

model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([enquiryId, createdAt])
  @@map("enquiry_notes")
}

// ─────────────────────────────────────────────────────────────
// 7. Editable site content
// ─────────────────────────────────────────────────────────────

enum BannerPlacement {
  HOME_HERO
  DOCTOR_HERO
  PATIENT_HERO
}

enum MediaType {
  IMAGE
  VIDEO
}

model Banner {
  id             String          @id @default(cuid())
  placement      BannerPlacement
  /// Small letterspaced line above the title on the hero.
  eyebrow        String?
  title          String?
  /// Second title line, rendered with the brand gradient accent.
  titleAccent    String?
  subtitle       String?         @db.Text
  ctaLabel       String?
  ctaHref        String?
  mediaType      MediaType       @default(IMAGE)
  /// Desktop artwork. Tablet/mobile fall back to this when unset.
  mediaUrl       String          @db.Text
  mediaUrlTablet String?         @db.Text
  mediaUrlMobile String?         @db.Text
  posterUrl      String?         @db.Text
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

/// Generic keyed content for the hand-written page sections (why-points,
/// about stats, headline bands). `data` holds shape-specific extras.
model ContentBlock {
  id        String  @id @default(cuid())
  key       String  @unique
  page      String
  section   String
  title     String?
  subtitle  String? @db.Text
  body      String? @db.Text
  image     String? @db.Text
  icon      String?
  data      Json?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, section, sortOrder])
  @@map("content_blocks")
}

model Testimonial {
  id          String  @id @default(cuid())
  authorName  String
  authorRole  String?
  avatarUrl   String? @db.Text
  quote       String  @db.Text
  rating      Int?
  treatmentId String?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatment Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@index([treatmentId])
  @@map("testimonials")
}

model Faq {
  id          String  @id @default(cuid())
  question    String  @db.Text
  answer      String  @db.Text
  category    String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@map("faqs")
}

enum SettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  JSON
}

model SiteSetting {
  id        String      @id @default(cuid())
  key       String      @unique
  value     String?     @db.Text
  type      SettingType @default(STRING)
  group     String      @default("general")
  label     String?
  updatedAt DateTime    @updatedAt

  @@index([group])
  @@map("site_settings")
}

// ─────────────────────────────────────────────────────────────
// 8. Operations: media, audit, email
// ─────────────────────────────────────────────────────────────

/// Registry of S3 objects uploaded through presigned URLs.
model MediaAsset {
  id           String    @id @default(cuid())
  /// S3 object key, e.g. "treatments/2026/botox-hero.jpg".
  storageKey   String    @unique
  /// Public CloudFront URL.
  url          String    @db.Text
  mimeType     String
  sizeBytes    Int?
  width        Int?
  height       Int?
  alt          String?
  mediaType    MediaType @default(IMAGE)
  uploadedById String?
  createdAt    DateTime  @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([mediaType, createdAt])
  @@map("media_assets")
}

/// A browser this person has allowed to show them notifications.
///
/// -- Why the endpoint is the identity -------------------------------------
/// The Push API gives one endpoint URL per browser per site. It is the only
/// stable handle there is: the same person on a phone and a laptop is two
/// subscriptions, and clearing site data makes a third. So the unique is on
/// the endpoint rather than on the user, and one user may have several.
///
/// -- Why dead subscriptions are deleted rather than kept ------------------
/// A push service answers 404 or 410 when a subscription has gone — the
/// browser was uninstalled, the permission revoked, the data cleared. Keeping
/// the row would mean retrying it forever on every reminder run. The send job
/// deletes on those two codes and only those two: a 500 from the push service
/// is their problem, not evidence that this browser is gone.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  /// The push service URL. Unique per browser per site. Capped at 500 rather
  /// than TEXT because MySQL cannot put a unique index on an unbounded column,
  /// and no push endpoint in the wild comes close to that.
  endpoint String @unique @db.VarChar(500)
  /// The two keys the Web Push encryption needs.
  p256dh   String @db.Text
  auth     String @db.Text

  /// For a person managing several devices in their settings.
  userAgent String? @db.Text

  createdAt  DateTime  @default(now())
  /// Stamped on a successful send, so a stale device is visible.
  lastSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("push_subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model EmailLog {
  id         String      @id @default(cuid())
  to         String
  subject    String
  template   String
  status     EmailStatus @default(QUEUED)
  providerId String?
  error      String?     @db.Text
  relatedId  String?
  createdAt  DateTime    @default(now())
  sentAt     DateTime?

  @@index([status, createdAt])
  @@index([relatedId])
  @@map("email_logs")
}

// ─────────────────────────────────────────────────────────────
// 9. Patient records — the My Profile sections
// ─────────────────────────────────────────────────────────────

/// A prescription issued to a patient after a consultation. `fileUrl` is the
/// uploaded PDF/image; the row exists even without one so the doctor's notes
/// are still on record.
model Prescription {
  id       String   @id @default(cuid())
  userId   String
  doctorId String?
  /// The visit it came out of. Recorded rather than merely used to authorise
  /// the write, so a patient's timeline can put the prescription against the
  /// consultation that produced it.
  appointmentId String?
  title    String
  notes    String?  @db.Text
  fileUrl  String?  @db.Text
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  items  PrescriptionItem[]

  @@index([userId, issuedAt])
  @@index([appointmentId])
  @@map("prescriptions")
}

/// One line of a prescription.
///
/// -- Why it points at Medicine, and why that is optional -----------------
/// A prescription used to be a title and a free-text note: "Tretinoin 0.025%
/// nightly" typed from memory, every time, by a doctor who already keeps a
/// list of exactly what they dispense. Picking off that list spells the name
/// the same way twice, carries the strength and form without retyping them,
/// and — the part that matters — lets the patient order the refill from the
/// practice that prescribed it instead of a stranger.
///
/// `medicineId` is nullable because two ordinary things must keep working: a
/// doctor prescribing something they do not stock, which is most of what a
/// dermatologist writes, and a medicine later delisted. The name, strength and
/// form are COPIED at the moment of issue for the same reason AftercareSheet
/// copies its content — this is a clinical instruction the patient acts on,
/// and re-pricing or renaming the catalogue must never change what they were
/// told to take.
model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  /// Null when written freehand, or once the medicine is delisted.
  medicineId     String?

  /// Snapshotted at issue. Never read back through the relation.
  name     String
  strength String?
  form     String?

  /// "One tablet twice a day, after food."
  dose     String?
  /// "14 days", "until the tube is finished".
  duration String?
  notes    String? @db.Text

  sortOrder Int @default(0)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([prescriptionId, sortOrder])
  @@index([medicineId])
  @@map("prescription_items")
}

/// An online purchase made by the patient. `amountInr` is their own
/// transaction, not catalogue pricing — the catalogue itself stays price-free.
model Purchase {
  id        String   @id @default(cuid())
  userId    String
  itemName  String
  quantity  Int      @default(1)
  status    String   @default("PLACED")
  amountInr Int?
  orderedAt DateTime @default(now())

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, orderedAt])
  @@map("purchases")
}

/// A discount made available to a patient (first-scan offer, loyalty, promo).
/// `usedAt` doubles as the redemption record.
model DiscountGrant {
  id           String    @id @default(cuid())
  userId       String
  code         String
  description  String
  percentOff   Int?
  amountOffInr Int?
  expiresAt    DateTime?
  usedAt       DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("discount_grants")
}

/// One completed "Help us to know you" questionnaire. Anonymous submissions
/// keep userId null; the answers blob is the whole quiz state as submitted.
model IntakeResponse {
  id      String  @id @default(cuid())
  userId  String?
  answers Json
  /// Human-readable one-liner for admin lists, derived at submit time.
  summary String? @db.Text

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("intake_responses")
}

// ─────────────────────────────────────────────────────────────
// 10. Payments (Razorpay)
// ─────────────────────────────────────────────────────────────

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

/// One payment attempt against an appointment.
///
/// A row is written when the Razorpay order is created and updated once the
/// signature is verified — so an abandoned checkout leaves a CREATED row
/// rather than nothing, and the same appointment can be retried without
/// losing the audit trail. Amounts are whole INR; `amountMinor` keeps the
/// paise figure actually sent to Razorpay so reconciliation never depends on
/// re-deriving it.
enum PaymentPurpose {
  APPOINTMENT
  SKIN_SCAN
  SUBSCRIPTION
  GIFT_CARD
}

model Payment {
  id             String         @id @default(cuid())
  /// What was bought. A payment is for exactly one of the two, and the
  /// matching id below is set — the other stays null.
  purpose        PaymentPurpose @default(APPOINTMENT)
  appointmentId  String?
  /// The gift card this payment bought. Set for GIFT_CARD only.
  giftCardId     String?
  /// The scan credit this payment bought, once the payment settles.
  entitlementId  String?
  /// The subscription term this payment bought, once the payment settles.
  subscriptionId String?
  userId         String?

  provider          String  @default("razorpay")
  providerOrderId   String  @unique
  providerPaymentId String? @unique
  /// Razorpay's returned signature, kept for dispute resolution.
  signature         String?

  amountInr     Int
  amountMinor   Int
  currency      String        @default("INR")
  status        PaymentStatus @default(CREATED)
  /// Razorpay's failure reason/description when a payment does not complete.
  failureReason String?       @db.Text

  paidAt DateTime?

  /// Refunds. Razorpay is the money's system of record; these columns are our
  /// copy of what it told us, so the ledger reconciles without a second call.
  refundId     String?
  refundedInr  Int?
  refundReason String?   @db.Text
  refundedAt   DateTime?
  /// The admin who issued it — a refund is a person's decision.
  refundedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([entitlementId])
  @@index([subscriptionId])
  @@index([purpose, status, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// 11. Client-facing catalogue (the explore hub)
// ─────────────────────────────────────────────────────────────
//
// Separate from Category/Treatment above, which is the clinician-facing
// catalogue behind /treatments and carries clinical notes and orderable
// products. This is the browse experience clients see: 18 categories, 108
// treatments, written for patients and edited by marketing.
//
// List-shaped fields (areas, includes, FAQs, options) are Json rather than
// side tables: they are edited as a block in one admin form, always read
// whole, and never queried across rows. A join table per bullet list would
// buy nothing and cost six more screens.

model HubCategory {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  /// Key into ICONS in components/hub/icons.tsx.
  icon  String
  /// Short line under the tile.
  blurb String @db.Text
  /// Longer intro shown on the category page.
  intro String @db.Text
  image String @db.Text
  /// Tailwind gradient classes for the icon chip.
  tint  String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatments HubTreatment[]
  protocol   TreatmentProtocol?

  @@index([isActive, sortOrder])
  @@map("hub_categories")
}

model HubTreatment {
  id          String  @id @default(cuid())
  categoryId  String
  slug        String
  name        String
  blurb       String  @db.Text
  image       String  @db.Text
  /// Treatment-specific illustrative comparison images. Both must be present
  /// before the patient page renders the before/after slider.
  beforeImage String? @db.Text
  afterImage  String? @db.Text
  /// Session count / downtime micro-fact. Never a price.
  meta        String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category         HubCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  beforeAfterCases HubBeforeAfterCase[]

  /// The URL is /patient/explore/<category>/<treatment>, so a slug only has
  /// to be unique inside its category.
  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
  @@map("hub_treatments")
}

model HubBeforeAfterCase {
  id          String @id @default(cuid())
  treatmentId String
  beforeImage String @db.Text
  afterImage  String @db.Text
  sortOrder   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treatment HubTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([treatmentId, sortOrder])
  @@index([treatmentId, sortOrder])
  @@map("hub_before_after_cases")
}

/// The clinical protocol shown on a treatment page. Held per category because
/// every treatment in one shares the same protocol; a treatment that needs its
/// own wording gets it through HubTreatment overrides later.
model TreatmentProtocol {
  id         String @id @default(cuid())
  categoryId String @unique

  /// string[] — three statements about who this suits.
  recommendedFor Json
  summary        String @db.Text
  howItWorks     String @db.Text
  /// TreatmentOption[] — { name, detail, popular }.
  options        Json
  /// string[]
  areas          Json
  duration       String
  anaesthesia    String
  sessions       String
  downtime       String
  results        String @db.Text
  /// string[] each
  includes       Json
  excludes       Json
  precautions    Json
  sideEffects    Json
  notSuitable    Json
  aftercare      Json
  /// TreatmentFaq[] — { q, a }.
  faqs           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category HubCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("treatment_protocols")
}

// ─────────────────────────────────────────────────────────────
// 12. Reviews, marketing content and appointment history
// ─────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// A client's rating of the doctor they saw.
///
/// Anchored to an appointment rather than to a doctor, which is what makes it
/// trustworthy: you can only review a consultation you actually attended, and
/// only once. Reviews are moderated before they appear, because a public
/// rating on a clinician is not something to publish unread.
model Review {
  id            String       @id @default(cuid())
  appointmentId String       @unique
  userId        String
  doctorId      String
  /// 1–5 whole stars.
  rating        Int
  title         String?
  body          String?      @db.Text
  status        ReviewStatus @default(PENDING)
  /// Why it was rejected, or a note for whoever looks next.
  adminNote     String?      @db.Text
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

/// A promotional offer on the explore hub. Percentages only — the catalogue
/// is price-free, so a deal advertises a discount, never a rupee figure.
model HubDeal {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  treatment     String
  categorySlug  String
  categoryLabel String
  image         String    @db.Text
  /// Percentage off — the only number shown. Never a rupee amount.
  discount      Int
  /// What is included, e.g. "Free follow-up + take-home kit".
  perk          String
  /// Social proof count shown on the card.
  claimed       Int       @default(0)
  /// Human urgency line, e.g. "Ends in 6 days".
  endsIn        String
  /// "Hot" deals get the prominent rail; the rest sit in the general list.
  isHot         Boolean   @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isHot, sortOrder])
  @@map("hub_deals")
}

/// A slide in the trending carousel on the explore hub.
model HubPromo {
  id        String    @id @default(cuid())
  slug      String    @unique
  eyebrow   String
  title     String
  body      String    @db.Text
  image     String    @db.Text
  cta       String
  href      String
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("hub_promos")
}

/// A "what is bothering you?" tile, which routes into a category.
model HubConcern {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  hint      String
  image     String  @db.Text
  /// The hub category slug this opens.
  category  String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("hub_concerns")
}

// ===========================================================================
//  CLINICS
//
//  Until now a clinic was two free-text strings on the doctor row, which made
//  three things impossible: a doctor holding hours at more than one location,
//  a client searching for the nearest branch, and a calendar that can tell
//  those locations apart. This is that entity.
//
//  A clinic exists independently of any doctor. Several practitioners share
//  one; a practitioner works at several. DoctorClinic is the join, and it
//  carries the fee because branches of the same practice charge differently.
// ===========================================================================

model Clinic {
  id           String  @id @default(cuid())
  /// The quotable identifier for these premises, e.g. "BLU-C-7Q2NX".
  /// See lib/publicId.ts — a cuid is a key, not something anybody reads out.
  publicId     String? @unique
  slug         String  @unique
  name         String
  addressLine1 String
  addressLine2 String?
  /// Neighbourhood, e.g. "Anna Nagar". What clients actually navigate by.
  area         String
  /// "Opposite the Krishna temple", "above Saravana Stores".
  ///
  /// In Indian cities this is how an address is actually given and how a
  /// driver is actually directed — the door number frequently is not enough
  /// and sometimes is not even displayed. Optional, because a clinic in a
  /// named tower does not need one.
  landmark     String?
  city         String
  state        String  @default("Tamil Nadu")
  /// Where the clinic is, as a country name.
  ///
  /// Added for the directory's Domestic / International split: without it
  /// every clinic was an undifferentiated city chip, and there was no way to
  /// tell an Indian city from an overseas one. Defaults to India because
  /// every clinic listed when this was added was Indian, and a default that
  /// silently marked them all "unknown" would empty the domestic tab.
  country      String  @default("India")
  pincode      String
  /// Set when the address has been geocoded, for "clinics near me".
  lat          Float?
  lng          Float?
  phone        String?
  email        String?
  /// Which swatch this location gets on the doctor calendar. An explicit
  /// column rather than a hash of the id, so it stays stable and a doctor
  /// with two similar-looking clinics can tell them apart deliberately.
  colorKey     String  @default("blue")
  about        String? @db.Text

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors        DoctorClinic[]
  photos         ClinicPhoto[]
  facilities     ClinicFacility[]
  availability   DoctorAvailability[]
  appointments   Appointment[]
  giftCardOffers GiftCardOffer[]
  expenses       PracticeExpense[]
  income         PracticeIncome[]
  assets         PracticeAsset[]

  @@index([isActive, city])
  @@index([city, area])
  @@map("clinics")
}

enum ClinicPhotoKind {
  EXTERIOR
  INTERIOR
  ROOM
}

/// Photographs of the premises. Clients judge a clinic on these before they
/// judge it on anything else, which is why onboarding asks for them.
model ClinicPhoto {
  id        String          @id @default(cuid())
  clinicId  String
  url       String          @db.Text
  kind      ClinicPhotoKind @default(INTERIOR)
  alt       String?
  sortOrder Int             @default(0)

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, kind, sortOrder])
  @@map("clinic_photos")
}

/// Parking, lift access, in-house pharmacy, a fractional CO2 laser.
///
/// Still free text rather than an enum, because the list grows with the
/// network and an admin should not need a migration to add "valet". What is
/// new is `category`: the picker now offers a curated list grouped into
/// access, comfort, clinical services and equipment, and storing which group
/// a facility came from is what lets a clinic page show them grouped rather
/// than as one undifferentiated run of thirty chips. Null for anything the
/// practitioner typed themselves.
model ClinicFacility {
  id        String  @id @default(cuid())
  clinicId  String
  name      String
  /// ACCESS | COMFORT | CLINICAL | EQUIPMENT | PAYMENT, or null for custom.
  /// A string rather than an enum for the same reason `name` is.
  category  String?
  sortOrder Int     @default(0)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name])
  @@map("clinic_facilities")
}

/// A practitioner practising at a location.
///
/// The fee lives here, not on Doctor, because the same doctor charges
/// differently at a flagship branch and a suburban one. Doctor.fee remains as
/// the headline figure and is kept in step with the primary clinic.
model DoctorClinic {
  doctorId  String
  clinicId  String
  /// Consultation fee in whole INR at this location.
  feeInr    Int     @default(0)
  /// The location that stands for this doctor in listings and on their card.
  /// Exactly one per doctor; enforced in the action, not the schema.
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([doctorId, clinicId])
  @@index([clinicId, isActive])
  @@index([doctorId, isPrimary])
  @@map("doctor_clinics")
}

// ===========================================================================
//  WHITE COLLAR  -  the client membership
//
//  Billed as a one-time order per term rather than through Razorpay's
//  Subscriptions API: it reuses settlePayment()'s existing purpose branch and
//  needs no dashboard Plan setup. The consequence, stated plainly, is that
//  nothing auto-debits — a term ends and the member is asked to renew.
//  razorpaySubscriptionId is reserved so true recurring billing can be added
//  later without moving any data.
// ===========================================================================

enum SubscriptionInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  /// Paid and inside its term.
  ACTIVE
  /// Term ran out without a renewal.
  EXPIRED
  /// Member stopped it. Benefits run to the end of the paid term.
  CANCELLED
}

model SubscriptionPlan {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  interval     SubscriptionInterval @default(MONTHLY)
  priceInr     Int
  /// Struck-through "was" figure, for the annual saving. Null shows no strike.
  compareAtInr Int?

  // ── What the member actually gets ────────────────────────────────────
  /// Taken off the consultation fee at every listed clinic.
  discountPercent      Int     @default(0)
  /// Skin scans granted at the start of each paid term.
  scanCredits          Int     @default(0)
  /// Unlocks held-back slots and protects the booking from being moved.
  priorityBooking      Boolean @default(false)
  /// Cancelling never costs a member the standard fee.
  waiveCancellationFee Boolean @default(false)
  /// Free-text bullets shown on the pricing card.
  perks                Json?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  planId String

  status SubscriptionStatus @default(ACTIVE)

  startedAt              DateTime  @default(now())
  /// The moment benefits stop. Renewing extends this rather than making a row.
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  /// Reserved for the Subscriptions API. Nothing auto-debits today.
  autoRenew              Boolean   @default(false)
  razorpaySubscriptionId String?   @unique

  /// Stops the renewal reminder going out twice for the same term.
  renewalNoticeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}
